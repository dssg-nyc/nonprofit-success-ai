select tests.login_as(:admin_id);

select lives_ok(
  $$ insert into architect_assessments (
       id, scout_intake_id, org_name, scout_bucket, scout_readiness,
       q1_org_context, q2_org_size, q3_poc,
       q4_collection_scope, q5_data_locations, q6_system_integration,
       q7_integration_familiarity, q8_quality_confidence,
       q9_current_decisions, q10_wished_decisions, q11_decision_empowerment,
       q12_reporting_to, q13_reporting_automation,
       q14_tools, q15_staff_confidence, q16_budget_speed,
       q17a_wish_list, q17b_biggest_worry, q18_past_blockers,
       di_score, gov_score, tooling_score, dc_score, tc_score,
       points, composite_level, charter, ninety_day_plan,
       created_by, created_by_email
     ) values (
       'cccccccc-0000-0000-0000-000000000001', 'cccccccc-0000-0000-0000-000000000001',
       'Seeded Org', 'Analytics & Insight', 'Ready',
       'ctx', 'size', 'poc', 'partial', 'locations', 'some_share',
       'somewhat_familiar', 'mixed', 'now', 'wished', 'leadership_managers',
       'board', 'semi_automated', '{spreadsheets}', 'some_adhoc', 'requires_approval',
       'wish', 'worry', 'blockers', 2, 2, 2, 2, 2, 10, 'Developing',
       '{}'::jsonb, '{}'::jsonb,
       '33333333-3333-3333-3333-333333333333', 'admin@dssg.nyc'
     ) $$,
  'an admin CAN create an assessment keyed to an existing intake (rules:199-202)'
);

select throws_ok(
  $$ update architect_assessments set created_by = '11111111-1111-1111-1111-111111111111'
     where id = 'cccccccc-0000-0000-0000-000000000001' $$,
  null,
  null,
  'created_by must be the acting admin (rules:202)'
);

select lives_ok(
  $$ update architect_assessments set composite_level = 'Established', points = 14
     where id = 'cccccccc-0000-0000-0000-000000000001' $$,
  'an admin CAN re-conduct an assessment (rules:203)'
);

select throws_ok(
  $$ delete from architect_assessments where id = 'cccccccc-0000-0000-0000-000000000001' $$,
  null,
  null,
  'nobody can delete an assessment — audit trail (rules:204)'
);

-- ---------------------------------------------------------------------------
-- engagements.assessment_id — 0002 step 2
--
-- Placed after the architect block on purpose: assessment cccc...0001 does not exist
-- until that block creates it, and the block's own first assertion requires the table
-- to be empty, so this cannot be seeded as a fixture instead.
-- ---------------------------------------------------------------------------

select tests.login_as(:alice_id);

select lives_ok(
  $$ update engagements
     set assessment_id = 'cccccccc-0000-0000-0000-000000000001'
     where id = 'aaaaaaaa-0000-0000-0000-000000000010' $$,
  'an owner CAN link their engagement to an assessment (0002: assessment_id)'
);

select throws_ok(
  $$ update engagements
     set assessment_id = '99999999-9999-9999-9999-999999999999'
     where id = 'aaaaaaaa-0000-0000-0000-000000000010' $$,
  '23503',
  null,
  'assessment_id cannot reference a nonexistent assessment (FK)'
);

-- ---------------------------------------------------------------------------
-- agent_runs + tool_calls — 0004 telemetry
--
-- Telemetry is written by the service role (bypasses RLS). Authenticated users
-- can only read if admin + org-scoped.
-- ---------------------------------------------------------------------------

-- Seed telemetry as superuser (service role equivalent in tests). Must reset role
-- first since prior sections leave us as authenticated.
reset role;
insert into agent_runs (id, agent, organization_id, model, input, output, duration_ms)
values ('ffffffff-0000-0000-0000-000000000001', 'scout', :org_id,
        'gemini-2.5-flash', '{"test": true}'::jsonb, '{"bucket": "Analytics"}'::jsonb, 150);

insert into tool_calls (id, agent_run_id, tool, input, output, duration_ms)
values ('ffffffff-0000-0000-0000-000000000002', 'ffffffff-0000-0000-0000-000000000001',
        'generateObject', '{"prompt": "test"}'::jsonb, '{"result": true}'::jsonb, 100);

select tests.login_as(:alice_id);

-- Non-admin cannot read telemetry.
select is_empty(
  $$ select id from agent_runs $$,
  'a non-admin cannot read agent_runs (0004: admin-only)'
);

select is_empty(
  $$ select id from tool_calls $$,
  'a non-admin cannot read tool_calls (0004: admin-only)'
);

-- Non-admin cannot write telemetry (no INSERT grant).
select throws_ok(
  $$ insert into agent_runs (agent, model, duration_ms)
     values ('scout', 'test', 100) $$,
  '42501',
  null,
  'a non-admin cannot insert agent_runs (0004: service-role only)'
);

select throws_ok(
  $$ insert into tool_calls (agent_run_id, tool, duration_ms)
     values ('ffffffff-0000-0000-0000-000000000001', 'test', 50) $$,
  '42501',
  null,
  'a non-admin cannot insert tool_calls (0004: service-role only)'
);

select tests.login_as(:admin_id);

select results_eq(
  $$ select count(*)::int from agent_runs $$,
  $$ values (1) $$,
  'an admin CAN read agent_runs in their org (0004: admin read)'
);

select results_eq(
  $$ select count(*)::int from tool_calls $$,
  $$ values (1) $$,
  'an admin CAN read tool_calls in their org (0004: admin read)'
);

-- ---------------------------------------------------------------------------
-- approvals — 0005 approval spine
-- ---------------------------------------------------------------------------

-- Seed an approval as superuser.
reset role;
insert into approvals (id, organization_id, agent, entity_type, entity_id, hitl_tier, status)
values ('ffffffff-0000-0000-0000-000000000010', :org_id, 'envoy', 'communication',
        'aaaaaaaa-0000-0000-0000-000000000010', 'L3', 'pending');

select tests.login_as(:alice_id);

-- Non-admin cannot read approvals.
select is_empty(
  $$ select id from approvals $$,
  'a non-admin cannot read approvals (0005: admin-only)'
);

-- Non-admin cannot update approvals (invisible via USING).
select is(
  tests.affected(
    $$ update approvals set status = 'approved'
        where id = 'ffffffff-0000-0000-0000-000000000010' $$),
  0,
  'a non-admin cannot update approval status (0005: admin-only)'
);

select tests.login_as(:admin_id);

select results_eq(
  $$ select count(*)::int from approvals $$,
  $$ values (1) $$,
  'an admin CAN read approvals in their org (0005: admin read)'
);

select lives_ok(
  $$ update approvals set status = 'approved',
         reviewer_id = '33333333-3333-3333-3333-333333333333',
         reviewed_at = now()
     where id = 'ffffffff-0000-0000-0000-000000000010' $$,
  'an admin CAN approve a pending approval (0005: status transition)'
);

-- ---------------------------------------------------------------------------
-- audit_events — 0005 approval spine (append-only)
-- ---------------------------------------------------------------------------

-- Seed as superuser.
reset role;
insert into audit_events (id, organization_id, actor_id, action, entity_type, entity_id)
values ('ffffffff-0000-0000-0000-000000000020', :org_id, :admin_id, 'approval.approved',
        'communication', 'aaaaaaaa-0000-0000-0000-000000000010');

select tests.login_as(:alice_id);

select is_empty(
  $$ select id from audit_events $$,
  'a non-admin cannot read audit_events (0005: admin-only)'
);

select tests.login_as(:admin_id);

select results_eq(
  $$ select count(*)::int from audit_events $$,
  $$ values (1) $$,
  'an admin CAN read audit_events in their org (0005: admin read)'
);

-- Append-only enforcement: no INSERT/UPDATE/DELETE grant for authenticated.
select throws_ok(
  $$ insert into audit_events (action) values ('test') $$,
  '42501',
  null,
  'authenticated cannot insert audit_events (0005: service-role only)'
);

select throws_ok(
  $$ update audit_events set action = 'rewritten' $$,
  '42501',
  null,
  'audit_events cannot be updated — append-only (0005)'
);

select throws_ok(
  $$ delete from audit_events $$,
  '42501',
  null,
  'audit_events cannot be deleted — append-only (0005)'
);

-- ---------------------------------------------------------------------------
-- milestones + tasks — 0006 delivery
-- ---------------------------------------------------------------------------

select tests.login_as(:alice_id);

select lives_ok(
  $$ insert into milestones (id, engagement_id, organization_id, title)
     values ('ffffffff-0000-0000-0000-000000000030',
             'aaaaaaaa-0000-0000-0000-000000000010',
             'eeeeeeee-0000-0000-0000-000000000001', 'Kick-off') $$,
  'an owner CAN create a milestone on their engagement (0006)'
);

select lives_ok(
  $$ insert into tasks (id, milestone_id, engagement_id, organization_id, title)
     values ('ffffffff-0000-0000-0000-000000000031',
             'ffffffff-0000-0000-0000-000000000030',
             'aaaaaaaa-0000-0000-0000-000000000010',
             'eeeeeeee-0000-0000-0000-000000000001', 'Gather data sources') $$,
  'an owner CAN create a task on their milestone (0006)'
);

select results_eq(
  $$ select count(*)::int from milestones $$,
  $$ values (1) $$,
  'an owner sees milestones on their engagement (0006)'
);

select results_eq(
  $$ select count(*)::int from tasks $$,
  $$ values (1) $$,
  'an owner sees tasks on their engagement (0006)'
);

-- Cross-org isolation.
select tests.login_as(:outsider_id);

select is_empty(
  $$ select id from milestones $$,
  'an outsider cannot see milestones in another org (0006: cross-org)'
);

select is_empty(
  $$ select id from tasks $$,
  'an outsider cannot see tasks in another org (0006: cross-org)'
);

select * from finish();

rollback;
